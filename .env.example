# LLM Provider: "ollama" (default, free local) or "gemini"
LLM_PROVIDER=ollama

# Ollama settings (default provider - free, no rate limits)
# Install: https://ollama.com  then run: ollama pull phi4-mini && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi4-mini
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gemini settings (set LLM_PROVIDER=gemini to use)
GOOGLE_API_KEY=your_gemini_api_key_here

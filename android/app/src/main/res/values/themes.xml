<resources>
    <!-- Broadsheet is a paper system: light ground, dark status-bar icons.
         enableEdgeToEdge in MainActivity owns the runtime bar styling; this
         only needs to stop the window flashing dark before Compose draws. -->
    <style name="Theme.AnkiGen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F3F2F2</item>
        <item name="android:navigationBarColor">#F3F2F2</item>
        <item name="android:windowBackground">#F3F2F2</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

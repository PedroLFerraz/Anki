<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend normally runs on a LAN machine over plain HTTP
  (e.g. http://192.168.1.42:8000), which Android blocks by default
  since API 28. Cleartext stays enabled here because the server URL is
  user-configurable to an arbitrary local address.

  Once the backend is deployed behind HTTPS, drop cleartextTrafficPermitted
  to false and this whole file can go away.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
